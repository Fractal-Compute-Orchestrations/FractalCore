# Project Fractal - Example Environment Configuration
# Copy this file to '.env' and populate your local credentials and paths.

# Hugging Face User Access Token (Required for gated models like Llama 3)
# Obtain from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Local target directory for caching raw model checkpoints (e.g. on a large external drive)
# Example: T:\models\Meta-Llama-3-8B or ./assets/raw_models/Meta-Llama-3-8B
RAW_MODEL_DIR=./assets/raw_models/Meta-Llama-3-8B
